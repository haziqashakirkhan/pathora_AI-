# Pathora AI Environment Configuration Example
# Copy this file to .env and provide your actual API keys and credentials.

# --- Search Provider Configuration ---
# Tavily Search API key (https://tavily.com) - Used to execute real-time opportunity discovery web searches
SEARCH_API_KEY=tvly-your_tavily_search_api_key_here

# --- LLM Provider Configuration ---
# Options: gemini (default) or groq
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# --- Firebase & Firestore Configuration ---
# Firebase project ID
FIREBASE_PROJECT_ID=your_firebase_project_id
# Path to your Firebase service account JSON key file (for Firebase Admin SDK backend authentication & Firestore)
GOOGLE_APPLICATION_CREDENTIALS=firebase-service-account.json

# --- Frontend Firebase Client Config (Optional for client-side Auth) ---
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com

# --- Email & Notifications (Resend) ---
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Pathora AI <onboarding@resend.dev>
CRON_SECRET=your_secure_cron_secret_here

# --- Application Settings ---
PORT=8000
HOST=127.0.0.1
DEBUG=True
CHATBOT_ENABLED=false
GEMINI_MODEL=gemini-flash-lite-latest

RESEND_API_KEY=re_your_actual_api_key_here
RESEND_FROM_EMAIL=Pathora AI <alerts@yourdomain.com>
CRON_SECRET=any_random_long_string_you_make_up